package com.mycompany.mavenproject6;

import java.util.Arrays;

public class Ordenamientos {

    public static void main(String[] args) {
        int[] arreglo = {38, 27, 43, 3, 9, 82, 10};
        System.out.println("Original: " + Arrays.toString(arreglo));
        
        ordenar(arreglo, 0, arreglo.length - 1);
        
        System.out.println("Ordenado: " + Arrays.toString(arreglo));
    }

    // Método principal de división (Recursivo)
    public static void ordenar(int[] arr, int izq, int der) {
        if (izq < der) { // 1 comparación
            int m = izq + (der - izq) / 2; // 4 operaciones (asig, suma, resta, div)
            
            ordenar(arr, izq, m);     // Llamada recursiva T(n/2)
            ordenar(arr, m + 1, der); // Llamada recursiva T(n/2)
            
            merge(arr, izq, m, der);  // Llamada al método de mezcla
        }
    }

    // Método para mezclar y ordenar (El corazón del algoritmo)
    public static void merge(int[] arr, int izq, int m, int der) {
        int n1 = m - izq + 1; // 3 operaciones (asig, resta, suma) [cite: 18]
        int n2 = der - m;     // 2 operaciones (asig, resta) [cite: 18]

        int L[] = new int[n1]; // 2 operaciones (creación, asig)
        int R[] = new int[n2]; // 2 operaciones (creación, asig)

        // Copia de datos a arreglos temporales
        for (int i = 0; i < n1; i++) { // 1 asig; n1+1 comp; n1 increm [cite: 19]
            L[i] = arr[izq + i];       // 3 op. por iteración (asig, suma, acceso)
        }
        for (int j = 0; j < n2; j++) { // 1 asig; n2+1 comp; n2 increm
            R[j] = arr[m + 1 + j];     // 4 op. por iteración (asig, suma, suma, acceso)
        }

        int i = 0, j = 0; // 2 asignaciones
        int k = izq;      // 1 asignación

        // Comparación y mezcla de los dos sub-arreglos
        while (i < n1 && j < n2) { // 2 comparaciones + 1 lógico [cite: 19, 27]
            if (L[i] <= R[j]) {    // 1 comparación + 2 accesos
                arr[k] = L[i];     // 1 asignación + 2 accesos [cite: 35]
                i++;               // 1 incremento
            } else {
                arr[k] = R[j];     // 1 asignación + 2 accesos
                j++;               // 1 incremento
            }
            k++;                   // 1 incremento
        }

        // Copiar elementos restantes de L[] si existen
        while (i < n1) {           // 1 comparación
            arr[k] = L[i];         // 1 asignación + 2 accesos
            i++; k++;              // 2 incrementos
        }

        // Copiar elementos restantes de R[] si existen
        while (j < n2) {           // 1 comparación
            arr[k] = R[j];         // 1 asignación + 2 accesos
            j++; k++;              // 2 incrementos
        }
        
        /* EXPRESIÓN ALGEBRAICA FINAL: 
           T(n) = 2T(n/2) + n + c
           Donde 'n' representa las comparaciones en el merge y 'c' las asignaciones constantes.
           
           NOTACIÓN ASINTÓTICA: O(n log n) [cite: 22]
           Justificación: El algoritmo divide el problema a la mitad en cada nivel (log n) 
           y realiza un trabajo lineal (n) para mezclar los elementos en cada nivel.
        */
    }
}
